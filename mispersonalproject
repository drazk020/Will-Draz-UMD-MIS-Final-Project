            <script>
                document.addEventListener('DOMContentLoaded', function() {
                    const crawl = document.querySelector('.crawl');
                    let currentPosition = 200; // Start position
                    let manualOffset = 0; // Track manual scroll offset
                    const maxScroll = -400; // Maximum scroll position
                    const minScroll = 200; // Minimum scroll position (starting point)
                    let isScrolling = false;
                    let scrollTimeout;
                    let autoScrollInterval;
                    const autoScrollSpeed = 0.5; // Pixels per frame

                    // Update scroll position
                    function updatePosition(delta, isAuto = false) {
                        if (!isAuto) {
                            // Add to manual offset when user scrolls
                            manualOffset -= delta;
                            // Limit manual offset
                            manualOffset = Math.max(-600, Math.min(600, manualOffset));
                        }
                        
                        // Combine auto-scroll position with manual offset
                        let totalPosition = currentPosition - delta + manualOffset;
                        totalPosition = Math.max(maxScroll, Math.min(minScroll, totalPosition));
                        crawl.style.transform = `rotateX(25deg) translateY(${totalPosition}px)`;
                        
                        // Reset when reaching the bottom
                        if (totalPosition <= maxScroll) {
                            currentPosition = minScroll;
                            manualOffset = 0; // Reset manual offset
                        }
                    }

                    // Start auto-scroll
                    autoScrollInterval = setInterval(() => {
                        currentPosition -= autoScrollSpeed;
                        updatePosition(0, true); // Update with auto-scroll
                        
                        if (currentPosition <= maxScroll) {
                            currentPosition = minScroll;
                            manualOffset = 0; // Reset manual offset when looping
                        }
                    }, 16); // ~60fps

                    // Handle mouse wheel
                    document.querySelector('.star-wars-intro').addEventListener('wheel', function(e) {
                        e.preventDefault();
                        updatePosition(e.deltaY * 0.5);
                        document.querySelector('.scroll-indicator').style.opacity = '0';
                    });

                    // Handle touch events
                    let touchStartY;
                    
                    document.querySelector('.star-wars-intro').addEventListener('touchstart', function(e) {
                        touchStartY = e.touches[0].clientY;
                        document.querySelector('.scroll-indicator').style.opacity = '0';
                    });

                    document.querySelector('.star-wars-intro').addEventListener('touchmove', function(e) {
                        e.preventDefault();
                        const touchDelta = touchStartY - e.touches[0].clientY;
                        updatePosition(touchDelta * 0.5);
                        touchStartY = e.touches[0].clientY;
                    });

                    // Handle keyboard events
                    document.addEventListener('keydown', function(e) {
                        if (e.key === 'ArrowUp') {
                            updatePosition(-10);
                        } else if (e.key === 'ArrowDown') {
                            updatePosition(10);
                        } else if (e.key === 'Space') {
                            // Reset manual offset when spacebar is pressed
                            manualOffset = 0;
                        }
                        document.querySelector('.scroll-indicator').style.opacity = '0';
                    });
                });
            </script>
