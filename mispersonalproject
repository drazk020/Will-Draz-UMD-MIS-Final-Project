        <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.5.1/dist/confetti.browser.min.js"></script>
        <script>
            function duplicateItems(reel) {
                const items = Array.from(reel.children);
                // Add items to the beginning for smooth transition
                items.forEach(item => {
                    const clone = item.cloneNode(true);
                    reel.insertBefore(clone, reel.firstChild);
                });
                // Add items to the end for smooth transition
                items.forEach(item => {
                    const clone = item.cloneNode(true);
                    reel.appendChild(clone);
                });
            }

            // Initialize reels on page load
            document.addEventListener('DOMContentLoaded', () => {
                const reels = document.querySelectorAll('.slot-items');
                reels.forEach(duplicateItems);
                
                // Position reels to show middle set of items initially
                reels.forEach(reel => {
                    const itemHeight = 80;
                    const itemCount = 6; // Number of original items
                    reel.style.transform = `translateY(${-itemHeight * itemCount}px)`;
                });
            });

            function spinSlots() {
                const slotMachine = document.querySelector('.slot-machine');
                const spinButton = document.querySelector('.spin-button');
                const winMessage = document.querySelector('.win-message');
                const reels = [
                    document.getElementById('reel1'),
                    document.getElementById('reel2'),
                    document.getElementById('reel3')
                ];
                
                // Disable spin button during spin
                spinButton.disabled = true;
                winMessage.classList.remove('visible');
                slotMachine.classList.add('spinning');

                // Remove previous winner classes
                document.querySelectorAll('.slot-item').forEach(item => {
                    item.classList.remove('winner');
                });

                const itemHeight = 80;
                const itemCount = 6; // Number of items in each reel
                const mainItems = ['about', 'education', 'interests', 'hobbies', 'skills', 'achievements'];
                const winningItem = mainItems[Math.floor(Math.random() * mainItems.length)];
                
                reels.forEach((reel, index) => {
                    const delay = index * 500; // Stagger the reel stops
                    
                    // Calculate random number of full rotations (2-4)
                    const rotations = 2 + Math.floor(Math.random() * 2);
                    
                    // Find position of winning item in middle set
                    const itemIndex = mainItems.indexOf(winningItem);
                    const initialOffset = itemCount * itemHeight; // Starting position (middle set)
                    const finalOffset = itemIndex * itemHeight; // Offset within set
                    
                    // Calculate total movement including rotations and final position
                    const totalSpins = (rotations * itemCount * itemHeight) + finalOffset;
                    
                    // Start spinning animation
                    setTimeout(() => {
                        reel.style.transition = 'transform 3s cubic-bezier(0.21, 0.53, 0.29, 0.99)';
                        reel.style.transform = `translateY(${-initialOffset - totalSpins}px)`;
                        
                        // After spinning ends
                        setTimeout(() => {
                            // Reset position to middle set without animation
                            reel.style.transition = 'none';
                            reel.style.transform = `translateY(${-initialOffset - finalOffset}px)`;
                            
                            // Highlight winning items
                            const winners = reel.querySelectorAll(`[data-value="${winningItem}"]`);
                            winners.forEach(winner => {
                                if (Array.from(winner.parentNode.children).indexOf(winner) >= itemCount) {
                                    winner.classList.add('winner');
                                }
                            });
                            
                            if (index === 2) {
                                spinButton.disabled = false;
                                winMessage.classList.add('visible');
                                slotMachine.classList.remove('spinning');
                                
                                // Trigger confetti animation
                                confetti({
                                    particleCount: 100,
                                    spread: 70,
                                    origin: { y: 0.6 },
                                    colors: ['#FFD700', '#FFFDD0', '#800000', '#A52A2A'],
                                    angle: 90,
                                    startVelocity: 30,
                                    gravity: 0.5,
                                    scalar: 0.7
                                });
                                
                                // Second burst of confetti after a small delay
                                setTimeout(() => {
                                    confetti({
                                        particleCount: 50,
                                        spread: 50,
                                        origin: { y: 0.6 },
                                        colors: ['#FFD700', '#FFFDD0', '#800000', '#A52A2A'],
                                        angle: 120,
                                        startVelocity: 25,
                                        gravity: 0.5,
                                        scalar: 0.65
                                    });
                                    confetti({
                                        particleCount: 50,
                                        spread: 50,
                                        origin: { y: 0.6 },
                                        colors: ['#FFD700', '#FFFDD0', '#800000', '#A52A2A'],
                                        angle: 60,
